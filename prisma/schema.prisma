generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SUPPORT
}

enum TxType {
  DEPOSIT_BONUS
  BET
  WIN
  DAILY_BONUS
  MISSION_REWARD
  REFERRAL_BONUS
  ADMIN_ADJUST
  REFUND
  DEPOSIT
  WITHDRAW
  CASHBACK
  VIP_BONUS
  CLAIM_REWARD
  WITHDRAW_HOLD
  WITHDRAW_REFUND
  WINGO_BET
  WINGO_WIN
  COMMISSION
}

enum GameType {
  CRASH
  DICE
  MINES
  WHEEL
  SLOTS
  PLINKO
  HILO
  WINGO
  COLOR_PREDICTION
  HEAD_TAIL
  SPIN_WHEEL
  DICE_ROLLING
  ROULETTE
  NUMBER_GUESS
  ANDAR_BAHAR
  KENO
  BLACKJACK
  ROCK_PAPER
  POOL_NUMBER
  CRAZY_TIMES
  DREAM_CATCHER
  JILI
  PG
  SPRIBE
  EVOLUTION
  FA_CHAI
  JDB
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestType {
  DEPOSIT
  WITHDRAW
}

enum ChatSender {
  USER
  SUPPORT
  SYSTEM
}

enum WingoGame {
  WINGO1
  WINGO3
  WINGO5
  WINGO10
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  role            Role      @default(USER)
  balance         Float     @default(0)
  avatar          String?
  vipLevel        Int       @default(0)
  vipExp          Float     @default(0)
  totalDeposit    Float     @default(0)
  totalBet        Float     @default(0)
  totalWin        Float     @default(0)
  totalCommission Float     @default(0)
  referralCode    String    @unique
  referredById    String?
  referredBy      User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]    @relation("Referrals")
  isBanned        Boolean   @default(false)
  isVerified      Boolean   @default(false)
  /// Feature permissions for SUPPORT/MODERATOR staff (JSON string array)
  permissions     Json?
  lastDailyAt     DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  pushEndpoint    String?
  pushP256dh      String?
  pushAuth        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions      Transaction[]
  missionProgress   MissionProgress[]
  bets              Bet[]
  wingoBets         WingoBetRecord[]
  walletRequests    WalletRequest[]
  chatMessages      ChatMessage[]
  notifications     Notification[]
  claims            RewardClaim[]
  notificationReads NotificationRead[]
  commissions       Commission[]  @relation("CommissionEarner")
  commissionsGiven  Commission[]  @relation("CommissionSource")
  passwordResets    PasswordReset[]
  presence          UserPresence?
  walletCards       WalletCard[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([role])
}

model WalletCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      String
  label       String
  accountNo   String
  accountName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@unique([userId, method, accountNo])
}

model UserPresence {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String   @default("/")
  lastSeen  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastSeen])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxType
  amount       Float
  balanceAfter Float
  note         String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model GameRound {
  id             String    @id @default(cuid())
  gameType       GameType
  serverSeed     String
  serverSeedHash String
  clientSeed     String?
  nonce          Int       @default(0)
  result         Json
  crashPoint     Float?
  status         String    @default("completed")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  bets           Bet[]

  @@index([gameType, startedAt])
}

model Bet {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId    String?
  round      GameRound? @relation(fields: [roundId], references: [id])
  gameType   GameType
  amount     Float
  payout     Float      @default(0)
  multiplier Float?
  cashedOut  Boolean    @default(false)
  won        Boolean    @default(false)
  meta       Json?
  createdAt  DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([gameType])
}

model WingoRound {
  id        String    @id @default(cuid())
  game      WingoGame
  period    Int
  result    Int?
  status    String    @default("open")
  startedAt DateTime  @default(now())
  closedAt  DateTime?
  bets      WingoBetRecord[]

  @@unique([game, period])
  @@index([game, status])
}

model WingoBetRecord {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId   String
  round     WingoRound @relation(fields: [roundId], references: [id])
  game      WingoGame
  bet       String
  amount    Float
  fee       Float      @default(0)
  payout    Float      @default(0)
  won       Boolean?
  status    String     @default("pending")
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([roundId])
  @@index([game, status])
}

model VipLevel {
  id            Int    @id
  nameEn        String
  nameBn        String
  minExp        Float
  dailyBonus    Float  @default(0)
  weeklyBonus   Float  @default(0)
  withdrawLimit Float  @default(50000)
  rebateRate    Float  @default(0)
  color         String @default("#FFD700")
  icon          String?
}

model Commission {
  id         String   @id @default(cuid())
  earnerId   String
  earner     User     @relation("CommissionEarner", fields: [earnerId], references: [id])
  sourceId   String
  source     User     @relation("CommissionSource", fields: [sourceId], references: [id])
  amount     Float
  rate       Float
  sourceType String
  level      Int
  createdAt  DateTime @default(now())

  @@index([earnerId, createdAt])
}

model Mission {
  id            String            @id @default(cuid())
  code          String            @unique
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  target        Int
  reward        Float
  active        Boolean           @default(true)
  sortOrder     Int               @default(0)
  progress      MissionProgress[]
}

model MissionProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress  Int      @default(0)
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
}

model AppConfig {
  id            String   @id @default("main")
  jackpot       Float    @default(1000000)
  announcements Json?
  banners       Json?
  gameConfig    Json?
  paymentConfig Json?
  supportConfig Json?
  wingoConfig   Json?
  vipConfig     Json?
  popupConfig   Json?
  referralConfig Json?
  /// Global house rule: when total open/session bets reach this, force house win
  houseRuleConfig Json?
  /// Branding: siteName, logoUrl, faviconUrl, telegramUrl, whatsappUrl
  brandConfig   Json?
  /// Catalog overrides: covers, sortOrder, enabled flags per game code
  gamesCatalog  Json?
  apkUrl        String?
  appVersion    String   @default("1.0.0")
  maintenance   Boolean  @default(false)
  currency      String   @default("BDT")
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  textEn    String
  textBn    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WalletRequest {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                RequestType
  method              String
  amount              Float
  status              RequestStatus @default(PENDING)
  accountName         String?
  accountNo           String?
  trxId               String?
  screenshotUrl       String?
  screenshotExpiresAt DateTime?
  note                String?
  adminNote           String?
  bonusAmount         Float         @default(0)
  processedBy         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([trxId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model ChatMessage {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         ChatSender
  message        String
  /// Display name of staff agent who replied (support/admin)
  agentName      String?
  agentId        String?
  imageUrl       String?
  imageExpiresAt DateTime?
  read           Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn   String
  titleBn   String
  bodyEn    String
  bodyBn    String
  href      String?
  imageUrl  String?
  global    Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@index([global, createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, notificationId])
}

model RewardClaim {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  titleEn   String
  titleBn   String
  reward    Float
  status    String    @default("available")
  expiresAt DateTime?
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, code])
  @@index([userId, status])
}

model UploadAsset {
  id        String    @id @default(cuid())
  kind      String
  path      String
  mimeType  String?
  size      Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}
