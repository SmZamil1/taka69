generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SUPPORT
}

enum TxType {
  DEPOSIT_BONUS
  BET
  WIN
  DAILY_BONUS
  MISSION_REWARD
  REFERRAL_BONUS
  ADMIN_ADJUST
  REFUND
  DEPOSIT
  WITHDRAW
  CASHBACK
  VIP_BONUS
  CLAIM_REWARD
  WITHDRAW_HOLD
  WITHDRAW_REFUND
  WINGO_BET
  WINGO_WIN
  COMMISSION
}

enum GameType {
  CRASH
  DICE
  MINES
  WHEEL
  SLOTS
  PLINKO
  HILO
  WINGO
  JILI
  PG
  SPRIBE
  EVOLUTION
  FA_CHAI
  JDB
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestType {
  DEPOSIT
  WITHDRAW
}

enum ChatSender {
  USER
  SUPPORT
  SYSTEM
}

enum WingoBet {
  // numbers 0-9
  N0
  N1
  N2
  N3
  N4
  N5
  N6
  N7
  N8
  N9
  // colors
  RED
  GREEN
  VIOLET
  // size
  BIG
  SMALL
}

enum WingoGame {
  WINGO1
  WINGO3
  WINGO5
  WINGO10
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  email           String?           @unique
  passwordHash    String
  role            Role              @default(USER)
  balance         Float             @default(0)
  avatar          String?
  phone           String?           @unique
  vipLevel        Int               @default(0)
  vipExp          Float             @default(0)
  totalDeposit    Float             @default(0)
  totalBet        Float             @default(0)
  totalWin        Float             @default(0)
  totalCommission Float             @default(0)
  referralCode    String            @unique
  referredById    String?
  referredBy      User?             @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]            @relation("Referrals")
  isBanned        Boolean           @default(false)
  lastDailyAt     DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  securityScore   Int               @default(20)
  pushEndpoint    String?
  pushP256dh      String?
  pushAuth        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  transactions    Transaction[]
  missionProgress MissionProgress[]
  bets            Bet[]
  wingoBets       WingoBetRecord[]
  walletRequests  WalletRequest[]
  chatMessages    ChatMessage[]
  notifications   Notification[]
  claims          RewardClaim[]
  notificationReads NotificationRead[]
  commissions     Commission[]      @relation("CommissionEarner")
  commissionsGiven Commission[]     @relation("CommissionSource")

  @@index([username])
  @@index([role])
  @@index([vipLevel])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxType
  amount       Float
  balanceAfter Float
  note         String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model GameRound {
  id             String    @id @default(cuid())
  gameType       GameType
  serverSeed     String
  serverSeedHash String
  clientSeed     String?
  nonce          Int       @default(0)
  result         Json
  crashPoint     Float?
  status         String    @default("completed")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  bets           Bet[]

  @@index([gameType, startedAt])
}

model Bet {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId    String?
  round      GameRound? @relation(fields: [roundId], references: [id])
  gameType   GameType
  amount     Float
  payout     Float      @default(0)
  multiplier Float?
  cashedOut  Boolean    @default(false)
  won        Boolean    @default(false)
  meta       Json?
  createdAt  DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([gameType])
}

// ── WinGo Color Prediction ──────────────────────────────────────

model WingoRound {
  id        String      @id @default(cuid())
  game      WingoGame
  period    Int
  result    Int?        // 0-9
  status    String      @default("open") // open | closed
  startedAt DateTime    @default(now())
  closedAt  DateTime?
  bets      WingoBetRecord[]

  @@unique([game, period])
  @@index([game, status])
}

model WingoBetRecord {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId   String
  round     WingoRound @relation(fields: [roundId], references: [id])
  game      WingoGame
  bet       String     // "0"-"9", "red","green","violet","big","small"
  amount    Float
  fee       Float      @default(0)
  payout    Float      @default(0)
  won       Boolean?
  status    String     @default("pending") // pending | won | lost
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([roundId])
  @@index([game, status])
}

// ── VIP System ──────────────────────────────────────────────────

model VipLevel {
  id          Int      @id
  name        String
  nameEn      String
  nameBn      String
  minExp      Float
  dailyBonus  Float    @default(0)
  weeklyBonus Float    @default(0)
  withdrawLimit Float  @default(50000)
  rebateRate  Float    @default(0)  // % cashback on losses
  color       String   @default("#gold")
  icon        String?
}

// ── Commission / Referral ───────────────────────────────────────

model Commission {
  id         String   @id @default(cuid())
  earnerId   String
  earner     User     @relation("CommissionEarner", fields: [earnerId], references: [id])
  sourceId   String
  source     User     @relation("CommissionSource", fields: [sourceId], references: [id])
  amount     Float
  rate       Float
  sourceType String   // "bet" | "deposit"
  level      Int      // 1, 2, 3 (referral depth)
  createdAt  DateTime @default(now())

  @@index([earnerId, createdAt])
  @@index([sourceId])
}

model Mission {
  id            String            @id @default(cuid())
  code          String            @unique
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  target        Int
  reward        Float
  active        Boolean           @default(true)
  sortOrder     Int               @default(0)
  progress      MissionProgress[]
}

model MissionProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress  Int      @default(0)
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
}

model AppConfig {
  id            String   @id @default("main")
  jackpot       Float    @default(1000000)
  announcements Json?
  banners       Json?
  gameConfig    Json?
  paymentConfig Json?
  supportConfig Json?
  popupConfig   Json?
  referralConfig Json?
  wingoConfig   Json?
  vipConfig     Json?
  apkUrl        String?
  appVersion    String   @default("1.0.0")
  maintenance   Boolean  @default(false)
  currency      String   @default("TK")
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  textEn    String
  textBn    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WalletRequest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          RequestType
  method        String
  amount        Float
  status        RequestStatus @default(PENDING)
  accountName   String?
  accountNo     String?
  trxId         String?
  screenshotUrl String?
  screenshotExpiresAt DateTime?
  note          String?
  adminNote     String?
  bonusAmount   Float         @default(0)
  processedBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([trxId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([screenshotExpiresAt])
}

model ChatMessage {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender        ChatSender
  message       String
  imageUrl      String?
  imageExpiresAt DateTime?
  read          Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([read])
  @@index([imageExpiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn   String
  titleBn   String
  bodyEn    String
  bodyBn    String
  href      String?
  imageUrl  String?
  global    Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@index([global, createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, notificationId])
}

model RewardClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  titleEn   String
  titleBn   String
  reward    Float
  status    String   @default("available")
  expiresAt DateTime?
  claimedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, status])
  @@unique([userId, code])
}

model UploadAsset {
  id        String   @id @default(cuid())
  kind      String
  path      String
  mimeType  String?
  size      Int?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([expiresAt])
}
