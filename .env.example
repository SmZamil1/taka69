# ===== REQUIRED FOR LIVE (Vercel + Neon) =====

# Neon Postgres connection string (use the pooled one on Vercel if available)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Long random secret — generate: openssl rand -base64 48
JWT_SECRET="replace-with-long-random-string"

# One-time bootstrap secret for POST /api/setup
SETUP_SECRET="replace-with-another-long-random-string"

# ===== APP / BASE URLS =====
NEXT_PUBLIC_APP_NAME="TAKA69"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Legacy/public URL fallback used by password reset and referral links
NEXT_PUBLIC_URL="https://your-app.vercel.app"

# ===== AUTH =====
# Google Identity Services client ID; leave blank to hide Google sign-in until configured
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Server-side fallback accepted by the Google token verifier
GOOGLE_CLIENT_ID=""

NEXT_PUBLIC_CURRENCY="TC"
NEXT_PUBLIC_STARTING_BALANCE="10000"

# ===== ADMIN (created by /api/setup or npm run db:seed) =====
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_EMAIL="admin@example.com"

# Optional auth/email and operations
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"
CRON_SECRET=""
